-- ═══════════════════════════════════════  
-- HELPER FUNCTIONS  
-- ═══════════════════════════════════════

local function buildPlayerList()  
listScroller:ClearAllChildren()  
playerList = {}  
local i = 1  
for _, plr in ipairs(Players:GetPlayers()) do  
if plr ~= localPlayer then  
local btn = Instance.new("TextButton")  
btn.Name = plr.Name  
btn.Size = UDim2.new(1, -4, 0, 20)  
btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)  
btn.BackgroundTransparency = 0.5  
btn.Text = plr.Name  
btn.TextColor3 = Color3.fromRGB(220, 220, 220)  
btn.Font = Enum.Font.Gotham  
btn.TextSize = 10  
btn.LayoutOrder = i  
btn.BorderSizePixel = 0  
btn.ZIndex = 2  
btn.Parent = listScroller

local c = Instance.new("UICorner")  
c.CornerRadius = UDim.new(0, 3)  
c.Parent = btn

table.insert(playerList, plr)  
i = i + 1  
end  
end  
countLabel.Text = string.format("Players: %d", #playerList)  
clampIndex()  
updateSelection()  
end

local function clampIndex()  
if #playerList == 0 then  
selectedIndex = 0  
return  
end  
selectedIndex = math.clamp(selectedIndex, 1, #playerList)  
end

local function updateSelection()  
if #playerList == 0 then  
infoLabel.Text = "No players"  
isSpectating = false  
return  
end  
local target = playerList[selectedIndex]  
if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then  
infoLabel.Text = string.format("[%d/%d] %s — waiting...", selectedIndex, #playerList, target and target.Name or "?")  
return  
end  
local hrp = target.Character.HumanoidRootPart  
infoLabel.Text = string.format("[%d/%d] %s  HP:%d", selectedIndex, #playerList, target.Name, math.ceil(target.Character.Humanoid.Health))  
targetCFrame = hrp.CFrame * CFrame.new(0, 5, 10)  
targetFocus = hrp.Position  
isSpectating = true  
end

local function navigate(dir)  
if #playerList == 0 then return end  
selectedIndex = selectedIndex + dir  
if selectedIndex < 1 then selectedIndex = #playerList end  
if selectedIndex > #playerList then selectedIndex = 1 end  
updateSelection()  
end

-- ═══════════════════════════════════════  
-- INPUT HANDLING  
-- ═══════════════════════════════════════

leftArrow.MouseButton1Click:Connect(function()  
navigate(-1)  
end)

rightArrow.MouseButton1Click:Connect(function()  
navigate(1)  
end)

toggleBtn.MouseButton1Click:Connect(function()  
local visible = mainFrame.Visible  
mainFrame.Visible = not visible  
shadowFrame.Visible = not visible  
toggleBtn.Text = visible and "▼" or "▲"  
end)

closeBtn.MouseButton1Click:Connect(function()  
if screenGui then  
screenGui:Destroy()  
end  
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)  
if gameProcessed then return end  
if input.KeyCode == Enum.KeyCode.Left then  
navigate(-1)  
elseif input.KeyCode == Enum.KeyCode.Right then  
navigate(1)  
elseif input.KeyCode == Enum.KeyCode.S then  
isSpectating = not isSpectating  
if isSpectating and #playerList > 0 then  
updateSelection()  
end  
end  
end)

-- ═══════════════════════════════════════  
-- PERSISTENCE — survives death/respawn  
-- ═══════════════════════════════════════

local function ensureGui()  
if not screenGui or not screenGui.Parent then  
createGui()  
buildPlayerList()  
end  
end

task.spawn(function()  
while true do  
ensureGui()  
task.wait(1)  
end  
end)

Players.PlayerAdded:Connect(function()  
buildPlayerList()  
end)

Players.PlayerRemoving:Connect(function()  
buildPlayerList()  
if selectedIndex > #playerList then  
selectedIndex = math.max(1, #playerList)  
end  
updateSelection()  
end)

-- ═══════════════════════════════════════  
-- SPECTATOR CAMERA LOOP  
-- ═══════════════════════════════════════

RunService.RenderStepped:Connect(function(dt)  
if not isSpectating or not targetCFrame or #playerList == 0 then  
return  
end

local target = playerList[selectedIndex]  
if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then  
updateSelection()  
return  
end

local hrp = target.Character.HumanoidRootPart  
local newTarget = hrp.CFrame * CFrame.new(0, 5, 10)  
local newFocus = hrp.Position

targetCFrame = targetCFrame:Lerp(newTarget, math.clamp(dt * CFG.LerpSpeed, 0, 1))  
targetFocus = targetFocus:Lerp(newFocus, math.clamp(dt * CFG.LerpSpeed, 0, 1))

camera.CFrame = targetCFrame  
camera.Focus = targetFocus  
camera.FieldOfView = CFG.SpectatorFov  
end)

print("[Spectator Mode] Loaded — persistent, smaller frame, draggable, white arrows.")  
