local Players = game:GetService("Players")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local NEXT_LABEL = "Next" -- change this to the text from your image

local gui = Instance.new("ScreenGui")
gui.Name = "SpectateGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function corner(o, r)
	Instance.new("UICorner", o).CornerRadius = UDim.new(0, r)
end

local BROWN = Color3.fromRGB(139, 94, 60)
local DARK = Color3.fromRGB(110, 70, 40)

-- Top-left toggle
local toggle = make("TextButton", {
	Size = UDim2.fromOffset(80, 26),
	Position = UDim2.new(0, 10, 0, 60),
	BackgroundColor3 = DARK,
	TextColor3 = Color3.new(1, 1, 1),
	Font = Enum.Font.GothamBold,
	TextSize = 13,
	Text = "Spectate",
}, gui)
corner(toggle, 6)

-- Bottom panel
local panel = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -20),
	Size = UDim2.fromOffset(260, 100),
	BackgroundColor3 = BROWN,
	BorderSizePixel = 0,
	Visible = false,
}, gui)
corner(panel, 8)
make("UIStroke", { Color = Color3.fromRGB(60, 35, 20), Thickness = 2 }, panel)

local title = make("TextLabel", {
	Size = UDim2.new(1, -10, 0, 24),
	Position = UDim2.fromOffset(5, 6),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(255, 240, 220),
	Font = Enum.Font.GothamBold,
	TextSize = 14,
	Text = "Not spectating",
}, panel)

local function makeBtn(text, pos)
	local b = make("TextButton", {
		Size = UDim2.fromOffset(76, 30),
		Position = pos,
		BackgroundColor3 = DARK,
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		Text = text,
	}, panel)
	corner(b, 6)
	return b
end

local prevBtn = makeBtn("Prev", UDim2.new(0, 8, 1, -38))        -- left edge
local stopBtn = makeBtn("Stop", UDim2.new(0.5, -38, 1, -38))    -- middle
local nextBtn = makeBtn(NEXT_LABEL, UDim2.new(1, -84, 1, -38))  -- right edge

-- Spectate logic
local target = nil
local charConn = nil

local function stop()
	target = nil
	if charConn then
		charConn:Disconnect()
		charConn = nil
	end
	title.Text = "Not spectating"
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then camera.CameraSubject = hum end
end

local function attachToTarget()
	if not target or not target.Character then return end
	local hum = target.Character:FindFirstChildOfClass("Humanoid")
	if hum then camera.CameraSubject = hum end
end

local function setTarget(p)
	target = p
	title.Text = "Spectating: " .. p.Name
	if charConn then charConn:Disconnect() end
	-- Keep following the target through their respawns
	charConn = p.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum and target == p then
			camera.CameraSubject = hum
		end
	end)
	attachToTarget()
end

-- Keep spectating after YOU die and respawn
player.CharacterAdded:Connect(function(char)
	if not target then return end
	char:WaitForChild("Humanoid", 10)
	-- Wait a moment so the default camera script finishes resetting first
	task.wait(0.2)
	attachToTarget()
end)

local function getOthers()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then table.insert(t, p) end
	end
	return t
end

-- Only changes target when you press Prev or Next
local function step(dir)
	local list = getOthers()
	if #list == 0 then
		stop()
		return
	end
	local idx = 0
	for i, p in ipairs(list) do
		if p == target then idx = i end
	end
	if idx == 0 then
		idx = dir > 0 and 1 or #list
	else
		idx = ((idx - 1 + dir) % #list) + 1
	end
	setTarget(list[idx])
end

prevBtn.MouseButton1Click:Connect(function() step(-1) end)
stopBtn.MouseButton1Click:Connect(stop)
nextBtn.MouseButton1Click:Connect(function() step(1) end)

toggle.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
	toggle.Text = panel.Visible and "Close" or "Spectate"
end)

Players.PlayerRemoving:Connect(function(leaving)
	if leaving == target then
		stop()
	end
end)
