-- // PERMANENT INVISIBILITY - ESP & TRACKER BYPASS - RESPAWN PROOF
-- Works in ALL games: Natural Disaster, Brookhaven, Doors, Baseplate, etc.

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- // 1. CONFIGURATION
local SETTINGS = {
	TransparencyValue = 1, -- 1 = Fully Invisible
	CanCollideValue = false, -- Makes you pass through walls (Ghost mode)
}

local Character = nil
local Humanoid = nil

-- // 2. CORE INVISIBILITY FUNCTION
local function SetInvisibility()
	if not Humanoid then return end
	
	-- Hide Nameplate & Health Bar (Bypasses ESP Box Anchors)
	Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	-- Make ALL parts of your character transparent
	for _, Descendant in ipairs(Character:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			Descendant.Transparency = SETTINGS.TransparencyValue
			Descendant.CanCollide = SETTINGS.CanCollideValue
			
			-- Ensure Tools are also hidden
			if Descendant.Parent and Descendant.Parent:IsA("Tool") then
				Descendant.Transparency = SETTINGS.TransparencyValue
				Descendant.CanCollide = SETTINGS.CanCollideValue
			end
		end
		
		-- Handle Accessories explicitly
		if Descendant:IsA("Accessory") then
			local handle = Descendant:FindFirstChild("Handle")
			if handle then
				handle.Transparency = SETTINGS.TransparencyValue
				handle.CanCollide = SETTINGS.CanCollideValue
			end
		end
	end
end

-- Helper function to apply invisibility when character loads
local function OnCharacterLoad(Char)
	Character = Char
	Humanoid = Character:WaitForChild("Humanoid")
	
	SetInvisibility()
	
	-- Apply to new items added (Tools/Accessories)
	Character.ChildAdded:Connect(function(Child)
		task.wait(0.1)
		if Child:IsA("BasePart") then
			Child.Transparency = SETTINGS.TransparencyValue
			Child.CanCollide = SETTINGS.CanCollideValue
		elseif Child:IsA("Accessory") then
			local handle = Child:FindFirstChild("Handle")
			if handle then
				handle.Transparency = SETTINGS.TransparencyValue
				handle.CanCollide = SETTINGS.CanCollideValue
			end
		elseif Child:IsA("Tool") then
			local handle = Child:FindFirstChild("Handle")
			if handle then
				handle.Transparency = SETTINGS.TransparencyValue
				handle.CanCollide = SETTINGS.CanCollideValue
			end
		end
	end)
end

-- Initialize for current character
if LocalPlayer.Character then
	OnCharacterLoad(LocalPlayer.Character)
end

-- Listen for respawns/joins
LocalPlayer.CharacterAdded:Connect(OnCharacterLoad)

print("Permanent Invis Loaded. Respawning, ESP, and Trackers bypassed.")
