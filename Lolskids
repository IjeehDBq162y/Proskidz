-- Find ALL possible character parts
local function findAllCharacterParts(character)
    if not character then return {} end
    
    local parts = {}
    
    -- Standard parts
    local rootParts = {
        character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChild("Torso"),
        character:FindFirstChild("UpperTorso"),
        character:FindFirstChild("LowerTorso"),
        character:FindFirstChild("Head"),
        character:FindFirstChild("Humanoid")
    }
    
    for _, part in ipairs(rootParts) do
        if part then
            table.insert(parts, part)
        end
    end
    
    -- Find ALL BaseParts in character
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            table.insert(parts, descendant)
        end
    end
    
    return parts
end

-- VISIBLE MASS FLAY function - everyone can see them fly and die
local function ultimateFling(targetPlayer)
    if targetPlayer == player then return end
    
    local targetCharacter = targetPlayer.Character
    if not targetCharacter then return end
    
    local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Get ALL parts
    local allParts = findAllCharacterParts(targetCharacter)
    
    -- Random direction for maximum chaos
    local randomDir = Vector3.new(
        math.random(-1000, 1000) / 10,
        1,
        math.random(-1000, 1000) / 10
    )
    
    local flingVelocity = Vector3.new(
        randomDir.X * 500,        -- 5000 POWER horizontal
        GUI_CONFIG.FlingHeight * 5, -- 5000 POWER vertical (launch into air)
        randomDir.Z * 500         -- 5000 POWER horizontal
    )
    
    -- MAKE THEM VISIBLE (ensure transparency is 0)
    for _, part in ipairs(allParts) do
        if part:IsA("BasePart") then
            pcall(function()
                part.Transparency = 0
                part.CanCollide = true
                part.CanTouch = true
            end)
        end
    end
    
    -- METHOD 1: LAUNCH THEM INTO THE AIR (visible to everyone)
    pcall(function()
        local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
        if rootPart then
            -- Launch them straight up into the air
            rootPart.AssemblyLinearVelocity = Vector3.new(
                randomDir.X * 500,
                5000,  -- LAUNCH INTO THE AIR
                randomDir.Z * 500
            )
        end
    end)
    
    -- METHOD 2: Direct velocity on EVERY part (visible fling)
    for _, part in ipairs(allParts) do
        if part:IsA("BasePart") then
            pcall(function()
                part.AssemblyLinearVelocity = flingVelocity
                part.Velocity = flingVelocity -- Legacy
                part.RotVelocity = Vector3.new(
                    math.random(-500, 500),
                    math.random(-500, 500),
                    math.random(-500, 500)
                )
            end)
        end
    end
    
    -- METHOD 3: BodyVelocity on root parts (launch into air)
    for _, part in ipairs(allParts) do
        if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso") then
            pcall(function()
                -- Remove existing forces
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("BodyMover") or child:IsA("Constraint") then
                        child:Destroy()
                    end
                end
                
                -- Add multiple BodyVelocities (launch into air)
                for i = 1, 5 do
                    local bodyVelocity = Instance.new("BodyVelocity")
                    bodyVelocity.Name = "BypassVelocity" .. i
                    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyVelocity.Velocity = Vector3.new(
                        randomDir.X * 500,
                        5000 + (i * 1000),  -- EXTREME AIR LAUNCH
                        randomDir.Z * 500
                    )
                    bodyVelocity.P = math.huge
                    bodyVelocity.Parent = part
                end
                
                -- Add BodyForce (5000+ power upward)
                local bodyForce = Instance.new("BodyForce")
                bodyForce.Force = Vector3.new(0, 1000000, 0)
                bodyForce.Parent = part
                
                -- Add BodyThrust (5000+ power upward)
                local bodyThrust = Instance.new("BodyThrust")
                bodyThrust.Force = Vector3.new(0, 500000, 0)
                bodyThrust.Parent = part
                
                -- Add BodyPosition (keep them in the air)
                local bodyPosition = Instance.new("BodyPosition")
                bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyPosition.P = math.huge
                bodyPosition.Position = part.Position + Vector3.new(0, 1000, 0)
                bodyPosition.Parent = part
                
                -- Add BodyGyro for spinning
                local bodyGyro = Instance.new("BodyGyro")
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.AngularVelocity = Vector3.new(
                    math.random(-500, 500),
                    math.random(-500, 500),
                    math.random(-500, 500)
                )
                bodyGyro.Parent = part
            end)
        end
    end
    
    -- METHOD 4: Use constraints (bypasses antifling that checks BodyMovers)
    pcall(function()
        local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
        if rootPart then
            -- LinearVelocity constraint (launch into air)
            local linearVelocity = Instance.new("LinearVelocity")
            linearVelocity.MaxForce = math.huge
            linearVelocity.VectorVelocity = Vector3.new(
                randomDir.X * 500,
                5000,
                randomDir.Z * 500
            )
            linearVelocity.Parent = rootPart
            
            -- AngularVelocity constraint
            local angularVelocity = Instance.new("AngularVelocity")
            angularVelocity.MaxTorque = math.huge
            angularVelocity.AngularVelocity = Vector3.new(
                math.random(-500, 500),
                math.random(-500, 500),
                math.random(-500, 500)
            )
            angularVelocity.Parent = rootPart
            
            -- AlignPosition to keep them in the air
            local alignPosition = Instance.new("AlignPosition")
            alignPosition.MaxForce = math.huge
            alignPosition.Responsiveness = 10
            alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
            alignPosition.Position = rootPart.Position + Vector3.new(0, 1000, 0)
            alignPosition.Parent = rootPart
        end
    end)
    
    -- METHOD 5: Direct CFrame manipulation (visible launch)
    pcall(function()
        local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
        if rootPart then
            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 500, 0)
        end
    end)
    
    -- METHOD 6: Humanoid manipulation (KILL THEM)
    pcall(function()
        humanoid.Jump = true
        humanoid.Sit = false
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        -- Kill them after they're launched
        task.delay(0.1, function()
            pcall(function()
                humanoid:TakeDamage(humanoid.MaxHealth)
            end)
        end)
    end)
    
    -- METHOD 7: Replicate to ALL clients so everyone sees it
    pcall(function()
        flingRemote:FireAllClients(targetPlayer)
    end)
    
    -- Cleanup after very short time (allows re-application)
    task.delay(0.1, function()
        for _, part in ipairs(allParts) do
            if part:IsA("BasePart") then
                pcall(function()
                    -- Remove our forces
                    for _, child in ipairs(part:GetChildren()) do
                        if child.Name:find("Bypass") or child:IsA("BodyForce") or child:IsA("BodyThrust") or 
                           child:IsA("BodyPosition") or child:IsA("BodyGyro") or child:IsA("LinearVelocity") or
                           child:IsA("AngularVelocity") or child:IsA("AlignPosition") then
                            child:Destroy()
                        end
                    end
                end)
            end
        end
    end)
end

