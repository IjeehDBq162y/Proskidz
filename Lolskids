-- Find ALL possible character parts
local function findAllCharacterParts(character)
    if not character then return {} end
    
    local parts = {}
    
    -- Standard parts
    local rootParts = {
        character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChild("Torso"),
        character:FindFirstChild("UpperTorso"),
        character:FindFirstChild("LowerTorso"),
        character:FindFirstChild("Head"),
        character:FindFirstChild("Humanoid")
    }
    
    for _, part in ipairs(rootParts) do
        if part then
            table.insert(parts, part)
        end
    end
    
    -- Find ALL BaseParts in character
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            table.insert(parts, descendant)
        end
    end
    
    return parts
end

-- ULTIMATE fling function - bypasses everything
local function ultimateFling(targetPlayer)
    if targetPlayer == player then return end
    
    local targetCharacter = targetPlayer.Character
    if not targetCharacter then return end
    
    local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Get ALL parts
    local allParts = findAllCharacterParts(targetCharacter)
    
    -- Random direction
    local randomDir = Vector3.new(
        math.random(-200, 200) / 10,
        1,
        math.random(-200, 200) / 10
    )
    
    local flingVelocity = Vector3.new(
        randomDir.X * 100,
        GUI_CONFIG.FlingHeight * 3,
        randomDir.Z * 100
    )
    
    -- Method 1: Direct velocity on EVERY part
    for _, part in ipairs(allParts) do
        if part:IsA("BasePart") then
            pcall(function()
                part.AssemblyLinearVelocity = flingVelocity
                part.Velocity = flingVelocity -- Legacy
                part.RotVelocity = Vector3.new(
                    math.random(-100, 100),
                    math.random(-100, 100),
                    math.random(-100, 100)
                )
            end)
        end
    end
    
    -- Method 2: BodyVelocity on root parts
    for _, part in ipairs(allParts) do
        if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso") then
            pcall(function()
                -- Remove existing forces
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("BodyMover") or child:IsA("Constraint") then
                        child:Destroy()
                    end
                end
                
                -- Add multiple BodyVelocities
                for i = 1, 3 do
                    local bodyVelocity = Instance.new("BodyVelocity")
                    bodyVelocity.Name = "BypassVelocity" .. i
                    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyVelocity.Velocity = flingVelocity * (1 + i * 0.5)
                    bodyVelocity.P = math.huge
                    bodyVelocity.Parent = part
                end
                
                -- Add BodyForce
                local bodyForce = Instance.new("BodyForce")
                bodyForce.Force = Vector3.new(0, 100000, 0)
                bodyForce.Parent = part
                
                -- Add BodyThrust
                local bodyThrust = Instance.new("BodyThrust")
                bodyThrust.Force = Vector3.new(0, 50000, 0)
                bodyThrust.Parent = part
                
                -- Add BodyPosition (teleport them up constantly)
                local bodyPosition = Instance.new("BodyPosition")
                bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyPosition.P = math.huge
                bodyPosition.Position = part.Position + Vector3.new(0, 100, 0)
                bodyPosition.Parent = part
                
                -- Add BodyGyro for spinning
                local bodyGyro = Instance.new("BodyGyro")
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.AngularVelocity = Vector3.new(
                    math.random(-50, 50),
                    math.random(-50, 50),
                    math.random(-50, 50)
                )
                bodyGyro.Parent = part
            end)
        end
    end
    
    -- Method 3: Use constraints (bypasses antifling that checks BodyMovers)
    pcall(function()
        local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
        if rootPart then
            -- LinearVelocity constraint
            local linearVelocity = Instance.new("LinearVelocity")
            linearVelocity.MaxForce = math.huge
            linearVelocity.VectorVelocity = flingVelocity
            linearVelocity.Parent = rootPart
            
            -- AngularVelocity constraint
            local angularVelocity = Instance.new("AngularVelocity")
            angularVelocity.MaxTorque = math.huge
            angularVelocity.AngularVelocity = Vector3.new(
                math.random(-50, 50),
                math.random(-50, 50),
                math.random(-50, 50)
            )
            angularVelocity.Parent = rootPart
            
            -- AlignPosition to force them up
            local alignPosition = Instance.new("AlignPosition")
            alignPosition.MaxForce = math.huge
            alignPosition.Responsiveness = 10
            alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
            alignPosition.Position = rootPart.Position + Vector3.new(0, 200, 0)
            alignPosition.Parent = rootPart
        end
    end)
    
    -- Method 4: Direct CFrame manipulation (last resort)
    pcall(function()
        local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
        if rootPart then
            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 50, 0)
        end
    end)
    
    -- Method 5: Humanoid manipulation
    pcall(function()
        humanoid.Jump = true
        humanoid.Sit = false
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end)
    
    -- Cleanup after very short time (allows re-application)
    task.delay(0.1, function()
        for _, part in ipairs(allParts) do
            if part:IsA("BasePart") then
                pcall(function()
                    -- Remove our forces
                    for _, child in ipairs(part:GetChildren()) do
                        if child.Name:find("Bypass") or child:IsA("BodyForce") or child:IsA("BodyThrust") or 
                           child:IsA("BodyPosition") or child:IsA("BodyGyro") or child:IsA("LinearVelocity") or
                           child:IsA("AngularVelocity") or child:IsA("AlignPosition") then
                            child:Destroy()
                        end
                    end
                end)
            end
        end
    end)
end

