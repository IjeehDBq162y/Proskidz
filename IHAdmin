		if NOTIFY.NOTIFY and NOTIFY.NOTIFY.NOTE then
			spawn(function()
				NOTIFY.NOTIFYTweenPosition(UDim2.new(0, 0, 0.4, 0), InOut, Quad, 0.5, true, nil)
