				usingNOTE = true
				wait(2.5)
				NOTIFY.NOTIFYTweenPosition(UDim2.new(0, -500, 0.7, 0), InOut, Quad, 0.5, true, nil)
				usingNOTE = false
		    end)
		end
	end
end

