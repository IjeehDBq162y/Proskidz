summonButton.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")

    local summonAnimation = Instance.new("Animation")
    summonAnimation.AnimationId = "rbxassetid://93693205"
    local summonTrack = humanoid:LoadAnimation(summonAnimation)
    summonTrack:Play()

    humanoid.WalkSpeed = 30

    local walkAnimation = Instance.new("Animation")
    walkAnimation.AnimationId = "rbxassetid://252557606"
    local walkTrack = humanoid:LoadAnimation(walkAnimation)

    humanoid.Running:Connect(function(speed)
        if speed > 0 then
            walkTrack:Play()
        else
            walkTrack:Stop()
        end
    end)

    local tool = Instance.new("Tool")
    tool.Name = "Attack"
    tool.Parent = player.Backpack

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0, 0, 0)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.Parent = tool

    local attackAnimation = Instance.new("Animation")
    attackAnimation.AnimationId = "rbxassetid://105211514"
    local attackTrack = humanoid:LoadAnimation(attackAnimation)

    tool.Equipped:Connect(function()
        tool.Activated:Connect(function()
            attackTrack:Play()
            wait(1)
            attackTrack:Stop()
        end)
    end)

    tool.Unequipped:Connect(function()
        attackTrack:Stop()
    end)
end)
