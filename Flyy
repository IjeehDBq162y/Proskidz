	-- 【Noclip解除時の復元処理】オフにした瞬間に元の衝突判定を読み込んで戻す
	if not Noclip then
		for part, originalState in pairs(originalCollision) do
			if part and part.Parent then
				part.CanCollide = originalState
			end
		end
		originalCollision = {} -- テーブルをリセット
	end
end)

