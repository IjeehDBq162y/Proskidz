------------------------------------------------
-- DRAG SYSTEM (FIXED)
------------------------------------------------

local dragging = false
local dragStart
local startPos

dragBtn.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1
	or i.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = i.Position
		startPos = frame.Position
	end
end)

UIS.InputChanged:Connect(function(i)
	if not dragging then return end
	if i.UserInputType ~= Enum.UserInputType.MouseMovement
	and i.UserInputType ~= Enum.UserInputType.Touch then return end

	local delta = i.Position - dragStart

	frame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end)

UIS.InputEnded:Connect(function()
	dragging = false
end)

------------------------------------------------
-- ANIMATION FIX (REAL FIX)
------------------------------------------------

local function disableAnimate(char)
	local a = char:FindFirstChild("Animate")
	if a then a.Disabled = true end
end

local function enableAnimate(char)
	local a = char:FindFirstChild("Animate")
	if a then a.Disabled = false end
end

local function startAnimLock(hum, char)
	if AnimLockLoop then AnimLockLoop:Disconnect() end

	disableAnimate(char)

	AnimLockLoop = RunService.RenderStepped:Connect(function()
		if not Flying or not hum then return end

		for _,v in ipairs(hum:GetPlayingAnimationTracks()) do
			v:Stop(0)
		end

		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)
end

local function stopAnimLock()
	if AnimLockLoop then
		AnimLockLoop:Disconnect()
		AnimLockLoop = nil
	end
end

------------------------------------------------
-- RESET ANIMATION
------------------------------------------------

local function resetAnim(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	hum.PlatformStand = false
	hum.AutoRotate = true

	hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	task.wait()
	hum:ChangeState(Enum.HumanoidStateType.Running)

	enableAnimate(char)
end

------------------------------------------------
-- NOCLIP (FIXED WITH RESTORE LOGIC)
------------------------------------------------

RunService.Stepped:Connect(function()
	if Destroyed or not Noclip then return end

	local char = Player.Character
	if not char then return end

	for _,p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			-- まだ保存されていない場合のみ、元のCanCollide状態を記憶する
			if originalCollision[p] == nil then
				originalCollision[p] = p.CanCollide
			end
			p.CanCollide = false
		end
	end
end)

------------------------------------------------
-- STOP FLY
------------------------------------------------

local function stopFly()
	Flying = false

	stopAnimLock()

	if Loop then Loop:Disconnect() Loop = nil end
	if BV then BV:Destroy() BV = nil end
	if BG then BG:Destroy() BG = nil end

	local char = Player.Character
	if char then resetAnim(char) end

	flyBtn.Text = "FLY"
end

------------------------------------------------
-- START FLY
------------------------------------------------

local function startFly()
	if Destroyed then return end

	local char = Player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end

	Flying = true

	startAnimLock(hum, char)

	hum.PlatformStand = true
	hum.AutoRotate = false
	hum:ChangeState(Enum.HumanoidStateType.Physics)

	BV = Instance.new("BodyVelocity")
	BV.MaxForce = Vector3.new(1e5,1e5,1e5)
	BV.Parent = root

	BG = Instance.new("BodyGyro")
	BG.MaxTorque = Vector3.new(1e5,1e5,1e5)
	BG.P = 10000
	BG.Parent = root

	Loop = RunService.RenderStepped:Connect(function()
		if Destroyed or not Flying then return end

		local cam = workspace.CurrentCamera
		BG.CFrame = cam.CFrame

		local dir = Vector3.zero
		
		-- PC向けのキーボード入力
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end

		-- モバイルのジョイスティック（MoveDirection）にも対応させる拡張
		if dir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
			local look = cam.CFrame.LookVector
			local right = cam.CFrame.RightVector
			dir = (look * (hum.MoveDirection:Dot(look)) + right * (hum.MoveDirection:Dot(right)))
		end

		BV.Velocity = (dir.Magnitude > 0 and dir.Unit * Speed) or Vector3.zero
	end)

	flyBtn.Text = "UNFLY"
end

