local selectedPlayer = nil
local isSpectating = false

local function updatePlayerList()
	PlayerList:ClearAllChildren()
	local searchText = SearchBox.Text:lower()
	local y = 0
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local match = player.Name:lower():find(searchText) or player.DisplayName:lower():find(searchText)
			if match then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 0, 40)
				btn.Position = UDim2.new(0, 0, 0, y)
				btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
				btn.Text = ""
				btn.Parent = PlayerList

				local display = Instance.new("TextLabel", btn)
				display.Size = UDim2.new(1, 0, 0, 20)
				display.Position = UDim2.new(0, 0, 0, 0)
				display.Text = player.DisplayName
				display.BackgroundTransparency = 1
				display.TextColor3 = Color3.new(1, 1, 1)
				display.Font = Enum.Font.SourceSansBold
				display.TextSize = 16

				local username = Instance.new("TextLabel", btn)
				username.Size = UDim2.new(1, 0, 0, 15)
				username.Position = UDim2.new(0, 0, 0, 20)
				username.Text = "@" .. player.Name
				username.BackgroundTransparency = 1
				username.TextColor3 = Color3.fromRGB(200, 200, 200)
				username.Font = Enum.Font.SourceSans
				username.TextSize = 14

				btn.MouseButton1Click:Connect(function()
					selectedPlayer = player
					for _, b in ipairs(PlayerList:GetChildren()) do
						if b:IsA("TextButton") then
							b.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
						end
					end
					btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
				end)
				y += 42
			end
		end
	end
	PlayerList.CanvasSize = UDim2.new(0, 0, 0, y)
end

ClearButton.MouseButton1Click:Connect(function()
	SearchBox.Text = ""
	updatePlayerList()
end)

SearchBox:GetPropertyChangedSignal("Text"):Connect(updatePlayerList)

Players.PlayerAdded:Connect(updatePlayerList)

Players.PlayerRemoving:Connect(function(p)
	if selectedPlayer == p then
		Camera.CameraSubject = LocalPlayer.Character:FindFirstChild("Humanoid")
		selectedPlayer = nil
		isSpectating = false
		ConfirmButton.Text = "Confirm"
	end
	updatePlayerList()
end)

ConfirmButton.MouseButton1Click:Connect(function()
	if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("Humanoid") then
		if not isSpectating then
			Camera.CameraSubject = selectedPlayer.Character:FindFirstChild("Humanoid")
			isSpectating = true
			ConfirmButton.Text = "Unconfirm"
		else
			Camera.CameraSubject = LocalPlayer.Character:FindFirstChild("Humanoid")
			isSpectating = false
			ConfirmButton.Text = "Confirm"
		end
	end
end)

CloseButton.MouseButton1Click:Connect(function()
	Notification.Visible = true
