no.MouseButton1Click:Connect(function()
	Notification.Visible = false
end)

yes.MouseButton1Click:Connect(function()
	if isSpectating then
		Camera.CameraSubject = LocalPlayer.Character:FindFirstChild("Humanoid")
		isSpectating = false
	end
	ScreenGui:Destroy()
end)

