local function shutdownServer()
    -- Show disconnect to everyone except you
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= me then
            local shutdownGui = Instance.new("ScreenGui", plr:WaitForChild("PlayerGui"))
            shutdownGui.Name = "Disconnect"
            
