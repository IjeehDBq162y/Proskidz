local function stopAll()
    stopAllEffects = true
    
    -- Reset lighting to normal
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Lighting.Brightness = 1
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0
    Lighting.FogColor = Color3.fromRGB(200, 200, 200)
    Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
    Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
    
    -- Remove skybox
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky then
        sky:Destroy()
    end
    
    -- Remove all fires
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Fire") then
            v:Destroy()
        end
        if v:IsA("BillboardGui") and v.Name == "stuf" then
            v:Destroy()
        end
        if v:IsA("SelectionBox") then
            v:Destroy()
        end
        if v:IsA("PointLight") then
            v:Destroy()
        end
    end
    
    -- Stop and remove all sounds (only sounds disappear)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            v:Stop()
            v:Destroy()
        end
    end
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("Sound") then
            v:Stop()
            v:Destroy()
        end
    end
    
    -- Reset all parts to normal
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.BrickColor = BrickColor.new("Medium stone grey")
            v.Material = Enum.Material.Plastic
        end
    end
    
    -- Reset all players
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
            end
            for _, part in pairs(plr.Character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.BrickColor = BrickColor.new("Bright blue")
                end
            end
        end
    end
    
    -- Remove forcefields
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            for _, ff in pairs(plr.Character:GetChildren()) do
                if ff:IsA("ForceField") then
                    ff:Destroy()
                end
            end
        end
    end
    
    -- Remove disconnect GUIs
    for _, plr in pairs(Players:GetPlayers()) do
        if plr:FindFirstChild("PlayerGui") then
            local disconnect = plr.PlayerGui:FindFirstChild("Disconnect")
            if disconnect then
                disconnect:Destroy()
            end
            local banScreen = plr.PlayerGui:FindFirstChild("BanScreen")
            if banScreen then
                banScreen:Destroy()
            end
        end
    end
    
    -- Remove blur effects
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") then
            v:Destroy()
        end
    end
    
    -- Reset after 5 seconds so effects can be used again
    wait(5)
    stopAllEffects = false
end

