-- STOP - Stops ALL Music for Everyone
local function stopMusicOnly()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            v:Stop()
            v:Destroy()
        end
    end
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("Sound") then
            v:Stop()
            v:Destroy()
        end
    end
end

