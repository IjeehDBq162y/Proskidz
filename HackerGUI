local function dayNightCycle()
    local lighting = game:GetService("Lighting")
    
    -- Stop any existing day/night loop
    if dayNightLoop then
        dayNightLoop = nil
    end
    
    -- Start day/night cycle
    dayNightLoop = spawn(function()
        while not stopAllEffects do
            -- Day time
            for i = 0, 1, 0.01 do
                lighting.ClockTime = 6 + (i * 12) -- 6 AM to 6 PM
                lighting.Brightness = 1 + (i * 1)
                lighting.Ambient = Color3.fromRGB(255 * (1 - i * 0.5), 255 * (1 - i * 0.5), 255 * (1 - i * 0.5))
                wait(0.1)
            end
            
            -- Night time
            for i = 0, 1, 0.01 do
                lighting.ClockTime = 18 + (i * 12) -- 6 PM to 6 AM
                lighting.Brightness = 1 - (i * 0.9)
                lighting.Ambient = Color3.fromRGB(255 * (1 - i * 0.8), 255 * (1 - i * 0.8), 255 * (1 - i * 0.8))
                wait(0.1)
            end
        end
    end)
end

local function stopAll()
    stopAllEffects = true
    
    -- Reset lighting
    local lighting = game:GetService("Lighting")
    lighting.Ambient = Color3.fromRGB(128, 128, 128)
    lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    lighting.Brightness = 1
    lighting.ClockTime = 14
    lighting.FogEnd = 100000
    lighting.FogStart = 0
    lighting.FogColor = Color3.fromRGB(200, 200, 200)
    lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
    lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
    
    -- Remove all fires
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Fire") then
            v:Destroy()
        end
        if v:IsA("BillboardGui") and v.Name == "stuf" then
            v:Destroy()
        end
        if v:IsA("SelectionBox") then
            v:Destroy()
        end
        if v:IsA("PointLight") then
            v:Destroy()
        end
    end
    
    -- Stop all sounds
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            v:Stop()
            v:Destroy()
        end
    end
    
    -- Reset all parts to normal
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.BrickColor = BrickColor.new("Medium stone grey")
            v.Material = Enum.Material.Plastic
        end
    end
    
    -- Reset all players
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
            end
            for _, part in pairs(plr.Character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.BrickColor = BrickColor.new("Bright blue")
                end
            end
        end
    end
    
    -- Remove forcefields
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            for _, ff in pairs(plr.Character:GetChildren()) do
                if ff:IsA("ForceField") then
                    ff:Destroy()
                end
            end
        end
    end
    
    -- Reset after 5 seconds so effects can be used again
    wait(5)
    stopAllEffects = false
end

