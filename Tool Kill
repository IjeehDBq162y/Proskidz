local function GetTargetTool()
	local char = lp.Character
	if not char then return nil end
	local currentTool = char:FindFirstChildOfClass("Tool")
	if currentTool then
		currentTool.Parent = lp.Backpack
		task.wait()
		currentTool.Parent = char
		return currentTool
	end
	local backpackTool = lp.Backpack:FindFirstChildOfClass("Tool")
	if backpackTool then
		backpackTool.Parent = char
		return backpackTool
	end
	return nil
end

local function RunVoid(targetPlayer)
	local Tchar = targetPlayer.Character
	local Thum = Tchar and Tchar:FindFirstChild("Humanoid")
	local Thrp = Tchar and Tchar:FindFirstChild("HumanoidRootPart")
	local RightArm = Tchar and (Tchar:FindFirstChild("Right Arm") or Tchar:FindFirstChild("RightHand"))
	
	if not Thum or not Thrp or Thum.Health <= 0 or not RightArm then return end
	
	local char = lp.Character
	local hum = char and char:FindFirstChild("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	
	if not hum or not hrp or hum.Health <= 0 then return end

	local SavedCFrame = hrp.CFrame
	local TargetSavedCFrame = Thrp.CFrame
	
	hum.Name = 1
	local Clone = char["1"]:Clone()
	Clone.Parent = char
	Clone.Name = "Humanoid"
	Clone:ChangeState(15)
	wait()
	hum:Destroy()
	char.Animate.Disabled = false
	wait()
	char.Animate.Disabled = true
	
	local currentHum = char:FindFirstChildOfClass("Humanoid")
	if currentHum then
		currentHum.DisplayDistanceType = "None"
	end

	local Tool = GetTargetTool()

	if Tool then
		local Handle = Tool:FindFirstChild("Handle")
		local Start = os.clock()
		if Handle then
			while Thrp.Parent == targetPlayer.Character and (os.clock() - Start) < 3 do
				task.wait()
				pcall(function()
					Thrp.CFrame = Handle.CFrame
					hrp.CFrame = CFrame.new(9999999,-495,9999999)
				end)
			end
			while lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") do
				task.wait()
				pcall(function()
					lp.Character.HumanoidRootPart.CFrame = CFrame.new(9999999,-495,9999999)
				end)
			end
			RS:WaitForChild("01_server"):FireServer("cmd","-re")
			local NewChar = lp.CharacterAdded:Wait()
			local NewRoot = NewChar:WaitForChild("HumanoidRootPart", 5)
			wait(0.1)
			if NewRoot then
				NewRoot.CFrame = SavedCFrame
			end
		end
	end
end

