local function ViewLogic(targetPlayer)
	UnviewLogic()
	
	local function updateSubject()
		if targetPlayer and targetPlayer.Parent then
			local char = targetPlayer.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					workspace.CurrentCamera.CameraSubject = hum
				else
					workspace.CurrentCamera.CameraSubject = char:FindFirstChild("HumanoidRootPart") or char
				end
			end
		else
			UnviewLogic()
		end
	end
	
	viewConnection = RunService.RenderStepped:Connect(updateSubject)
end

local function executeAction(cmd)
	local targetName = TextBox.Text
	if targetName == "" then return end
	local plrs = gplr(targetName)
	if #plrs > 0 then
		local target = plrs[1]
		if cmd == "goto" then
			GotoLogic(target)
		elseif cmd == "view" then
			ViewLogic(target)
		elseif cmd == "bring" then
			if isExecuting then return end
			isExecuting = true
			task.spawn(function()
				pcall(function() RunBring(target) end)
				isExecuting = false
			end)
		elseif cmd == "void" then
			if isExecuting then return end
			isExecuting = true
			task.spawn(function()
				pcall(function() RunVoid(target) end)
				isExecuting = false
			end)
		elseif cmd == "null" then
			if isExecuting then return end
			isExecuting = true
			task.spawn(function()
				pcall(function() RunNull(target) end)
				isExecuting = false
			end)
		elseif cmd == "give" then
			if isExecuting then return end
			isExecuting = true
			task.spawn(function()
				pcall(function() RunGive(target) end)
				isExecuting = false
			end)
		elseif cmd == "fling" then
			if isExecuting then return end
			isExecuting = true
			task.spawn(function()
				pcall(function() RunFling(target) end)
				isExecuting = false
			end)
		end
	end
end

