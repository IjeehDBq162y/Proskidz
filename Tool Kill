	if viewConnection then viewConnection:Disconnect() viewConnection = nil end
	workspace.CurrentCamera.CameraSubject = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") or lp.Character
end

local function updateDropdownPosition()
	if isMinimized then
		DropdownFrame.Position = UDim2.new(ui.Position.X.Scale, ui.Position.X.Offset + 5, ui.Position.Y.Scale, ui.Position.Y.Offset + 40)
	else
		DropdownFrame.Position = UDim2.new(ui.Position.X.Scale, ui.Position.X.Offset + 5, ui.Position.Y.Scale, ui.Position.Y.Offset + 145)
	end
end

ui:GetPropertyChangedSignal("Position"):Connect(updateDropdownPosition)
updateDropdownPosition()

local function rebuildDropdown()
	for _, child in pairs(DropdownFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local currentCount = 0
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= lp then
			currentCount = currentCount + 1
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, 0, 0, 22)
			pBtn.BackgroundColor3 = Color3.new(0.18, 0.18, 0.18)
			pBtn.BorderSizePixel = 0
			pBtn.Font = Enum.Font.SourceSans
			pBtn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
			pBtn.TextColor3 = Color3.new(0.9, 0.9, 0.9)
			pBtn.TextScaled = true
			pBtn.Parent = DropdownFrame
			
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 3)
			corner.Parent = pBtn
			
			pBtn.MouseButton1Click:Connect(function()
				TextBox.Text = player.Name
				dropdownOpen = false
				DropdownOpenValue.Value = false
				DropdownFrame.Visible = false
				DropBtn.Text = "+"
			end)
		end
	end
	DropdownFrame.CanvasSize = UDim2.new(0, 0, 0, currentCount * 24)
end

Players.PlayerRemoving:Connect(function(player)
	rebuildDropdown()
	local currentText = TextBox.Text
	if currentText ~= "" then
		local matches = gplr(currentText)
		if #matches > 0 and matches[1] == player then
			UnviewLogic()
			TextBox.Text = ""
		elseif player.Name:lower() == currentText:lower() then
			UnviewLogic()
			TextBox.Text = ""
		end
	end
end)

Players.PlayerAdded:Connect(rebuildDropdown)
rebuildDropdown()

DropBtn.MouseButton1Click:Connect(function()
	dropdownOpen = not dropdownOpen
	DropdownOpenValue.Value = dropdownOpen
	if dropdownOpen then
		rebuildDropdown()
		updateDropdownPosition()
		DropdownFrame.Visible = true
		DropBtn.Text = "-"
	else
		DropdownFrame.Visible = false
		DropBtn.Text = "+"
	end
end)

SubmitBtn.MouseButton1Click:Connect(function()
