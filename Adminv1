-- Helpers  
local function getChar() return LocalPlayer.Character end  
local function getRoot() local c = getChar() return c and c:FindFirstChild("HumanoidRootPart") end  
local function getHum() local c = getChar() return c and c:FindFirstChildOfClass("Humanoid") end  
local function getCam() return Workspace.CurrentCamera end  
local function getAllParts(char)  
	local parts = {}  
	if char then  
		for _, p in pairs(char:GetDescendants()) do  
			if p:IsA("BasePart") then table.insert(parts, p) end  
		end  
	end  
	return parts  
end

-- Output log  
local maxLines = 300  
local function logLine(text, color)  
	local label = Instance.new("TextLabel", OutputScrolling)  
	label.Size = UDim2.new(1, 0, 0, 15)  
	label.BackgroundTransparency = 1  
	label.Text = text  
	label.TextColor3 = color or Color3.fromRGB(200, 200, 200)  
	label.TextScaled = true  
	label.Font = Enum.Font.Code  
	label.TextXAlignment = Enum.TextXAlignment.Left  
	label.TextTruncate = Enum.TextTruncate.AtEnd  
	local count = 0  
	for _ in pairs(OutputScrolling:GetChildren()) do count = count + 1 end  
	if count > maxLines then  
		OutputScrolling:GetChildren()[1]:Destroy()  
	end  
	OutputScrolling.CanvasSize = UDim2.new(0, 0, 0, count * 17)  
end

-- Parse command from input  
local function parseCmd(input)  
	local s = input:match("^%s*(.-)%s*$")  
	if not s or s == "" then return nil, {} end  
	if s:sub(1, 1) == "/" then s = s:sub(2) end  
	if s == "" then return nil, {} end  
	local parts = {}  
	for w in s:gmatch("%S+") do table.insert(parts, w) end  
	local cmd = parts[1] and parts[1]:lower() or nil  
	table.remove(parts, 1)  
	return cmd, parts  
end

-- Find player by partial name  
local function findPlayer(partial)  
	local lower = partial:lower()  
	for _, pl in pairs(Players:GetPlayers()) do  
		if pl.Name:lower():find(lower) then return pl end  
	end  
	return nil  
end

