-- BIND INPUT TO COMMAND  
-- ═══════════════════════════════════════

local isOn = false  
local yieldActive = false

local function execCommand(input)  
	local cmd, args = parseCmd(input)  
	if not cmd then return end  
	local handler = commands[cmd]  
	if handler then  
		pcall(handler, args)  
	else  
		-- Fuzzy match  
		local found = false  
		for k, v in pairs(commands) do  
			if k:sub(1, #cmd) == cmd then  
				v(args)  
				found = true  
				break  
			end  
		end  
		if not found then  
			logLine("Unknown: /" .. cmd .. " — type /help", Color3.fromRGB(255, 100, 100))  
		end  
	end  
end

CmdInput.FocusLost:Connect(function(enterPressed)  
	if enterPressed then  
		local text = CmdInput.Text  
		if text and text ~= "" then  
			logLine("> /" .. text, Color3.fromRGB(100, 100, 100))  
			execCommand(text)  
			CmdInput.Text = ""  
		end  
	end  
end)

UIS.InputBegan:Connect(function(i, gpe)  
	if gpe then return end  
	if i.KeyCode == Enum.KeyCode.Enter and CmdInput.Focused then  
		CmdInput.FocusLost:Fire(true)  
	end  
end)

