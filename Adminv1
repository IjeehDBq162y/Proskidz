commands.tp = function(args)  
	local target = args[1] or "Player"  
	local pl = findPlayer(target)  
	if pl and pl.Character then  
		local tRoot = pl.Character:FindFirstChild("HumanoidRootPart")  
		local myRoot = getRoot()  
		if tRoot and myRoot then  
			myRoot.CFrame = tRoot.CFrame + Vector3.new(0, 3, 0)  
			logLine("Teleported to " .. pl.Name, Color3.fromRGB(0, 255, 100))  
		else  
			logLine("Could not teleport — no root part", Color3.fromRGB(255, 100, 100))  
		end  
	else  
		logLine("Player not found: " .. target, Color3.fromRGB(255, 100, 100))  
	end  
end

